---
// Root: send visitors to /it/ or /en/ based on browser language. Static-host friendly.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Gaetano Longo</title>
    <meta http-equiv="refresh" content="0; url=/en/" />
    <link rel="canonical" href="/en/" />
    <script is:inline>
      var l = (navigator.language || 'en').toLowerCase().indexOf('it') === 0 ? 'it' : 'en';
      location.replace('/' + l + '/');
    </script>
  </head>
  <body><a href="/en/">English</a> · <a href="/it/">Italiano</a></body>
</html>
