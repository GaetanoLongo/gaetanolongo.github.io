---
import Base from '../../../layouts/Base.astro';
import { ui, other, type Lang } from '../../../i18n';
import { getCollection, splitId, hasTranslation } from '../../../lib/content';
import { render } from 'astro:content';

export async function getStaticPaths() {
  return (await getCollection('recipes')).map((entry) => {
    const { lang, slug } = splitId(entry.id);
    return { params: { lang, slug }, props: { entry } };
  });
}
const { entry } = Astro.props;
const lang = Astro.params.lang as Lang;
const slug = Astro.params.slug as string;
const t = ui[lang];
const r = t.recipe;
const { Content } = await render(entry);
const d = entry.data;
const switchHref = (await hasTranslation('recipes', lang, slug))
  ? `/${other(lang)}/recipes/${slug}/` : `/${other(lang)}/recipes/`;
const url = new URL(Astro.url.pathname, Astro.site).href;
---
<Base lang={lang} title={d.title} description={d.description} active="recipes" switchHref={switchHref}>
  <article>
    <header class="recipe-head">
      <a class="meta" href={`/${lang}/recipes/`}>← {t.sections.recipes.title}</a>
      <h1>{d.title}</h1>
      <p class="lead">{d.description}</p>
      {(d.servings || d.prep || d.cook || d.oven) && (
        <dl class="facts">
          {d.servings && <div><dt>{r.servings}</dt><dd>{d.servings}</dd></div>}
          {d.prep && <div><dt>{r.prep}</dt><dd>{d.prep}</dd></div>}
          {d.cook && <div><dt>{r.cook}</dt><dd>{d.cook}</dd></div>}
          {d.oven && <div><dt>{r.oven}</dt><dd>{d.oven}</dd></div>}
        </dl>
      )}
      {d.source && (
        <p class="recipe-source">{r.source}: {/^https?:\/\//.test(d.source) ? <a href={d.source} rel="noopener">{d.source}</a> : d.source}</p>
      )}
      <div class="actions"><button class="btn" type="button" data-print>{r.print}</button></div>
    </header>

    <div class="recipe-body">
      <aside class="ingredients">
        <h2>{r.ingredients}</h2>
        <ul>{d.ingredients.map((x) => <li><span class="q">{x.q}</span><span>{x.i}</span></li>)}</ul>
      </aside>
      <section class="method">
        <h2>{r.method}</h2>
        <div class="prose"><Content /></div>
      </section>
    </div>
    <p class="print-url">{url}</p>
  </article>
</Base>
