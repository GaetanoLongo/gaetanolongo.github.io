---
import Base from '../../../layouts/Base.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import { languages, ui, type Lang } from '../../../i18n';
import { getCollection, inLang } from '../../../lib/content';

export const getStaticPaths = () => languages.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const s = ui[lang].sections.projects;
const items = inLang(await getCollection('projects'), lang).sort((a, b) => a.entry.data.order - b.entry.data.order);
---
<Base lang={lang} title={s.title} description={s.lead} active="projects">
  <div class="page-head"><h1>{s.title}</h1><p>{s.lead}</p></div>
  <div class="cards">{items.map(({ entry }) => <ProjectCard lang={lang} {...entry.data} />)}</div>
</Base>
